# ~/.zsh_secrets — YOUR private environment variables (API keys, tokens, endpoints).
#
# chezmoi created this file once as an empty template and never overwrites it afterwards.
# Fill in real values HERE, on this machine, by hand (alias: es). Never put real values in the
# dotfiles repo. Format: export NAME="value"   (zsh and bash source it; PowerShell reads the same lines)
#
# AI launchers in ~/.zsh/ai.zsh: cc, zai, glm, gpt, grok, cg, ds
# export _LOCAL_AI_URL=""     # Anthropic-compatible gateway base URL used by cc / gpt / grok / cg / glm
# export _LOCAL_AI_TOKEN=""
# export _ZAI_URL=""          # zai
# export _ZAI_TOKEN=""
# export _DS_TOKEN=""         # ds (DeepSeek)
#
# opencommit (oco)
# export OCO_API_URL=""       # your endpoint, e.g. https://<gateway>/v1
# export OCO_API_KEY=""       # defaults to _LOCAL_AI_TOKEN when unset
