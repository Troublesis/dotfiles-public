#!/bin/zsh
# macOS-specific settings

# --- macOS-specific exports ---
BUN_INSTALL="${HOME}/Library/Application Support/reflex/bun"
export BUN_INSTALL
export MAS_NO_AUTO_INDEX=1
export HOMEBREW_NO_ENV_HINTS=1
# EDITOR/VISUAL now set cross-platform in common.zsh (existence-guarded).
export YAZI_FILE_ONE="$(first_command_path file || printf '/usr/bin/file')"

# czkawka_gui requires Homebrew's share dir on XDG_DATA_DIRS; prepend without
# clobbering any existing entries (falls back to the XDG default when unset).
export XDG_DATA_DIRS="/opt/homebrew/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# NOTE: $BUN_INSTALL/bin is on PATH via ~/.zprofile (login shell).

# --- macOS ssh-agent: load keys from Keychain on first interactive shell ---
# `AddKeysToAgent yes` (in ~/.ssh/config) + `ssh-add --apple-use-keychain`
# together make keys survive reboot.  We only run this in an interactive
# TTY (never in non-interactive sessions like CI/cron), and only when the
# agent is reachable but empty, so it never prompts more than once per boot.
if [[ -o interactive ]] && [[ -t 1 ]]; then
    if ssh-add -l >/dev/null 2>&1; then
        : # agent already has identities — nothing to do
    elif [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
        # Agent reachable but empty: pull passphrases from Keychain silently.
        # Keys without a passphrase load without any keychain entry.
        ssh-add --apple-use-keychain ~/.ssh/id_ed25519 2>/dev/null
    fi
fi

# --- tmux: warn when the server has lost Local Network access ---
# macOS Local Network privacy ties a background tmux server to the app instance
# that started it (kitty, Ghostty, Terminal). If that app quits, macOS treats
# the server as responsible for itself. Every pane then gets EHOSTUNREACH for
# 192.168.x.x (ping times out, WAN still works) until the server is restarted.
# tmux-auto.zsh calls this hook before attaching. It prints nothing when healthy.
tmux_server_notice() {
    local spid rpid
    spid=$(command tmux display-message -p '#{pid}' 2>/dev/null) || return 0
    rpid=$(osascript -l JavaScript -e 'function run(a) {
        ObjC.bindFunction("responsibility_get_pid_responsible_for_pid", ["int", ["int"]]);
        return $.responsibility_get_pid_responsible_for_pid(Number(a[0])); }' \
        "$spid" 2>/dev/null) || return 0
    [[ -n "$spid" && "$rpid" == "$spid" ]] || return 0
    print -r -- "tmux server $spid has NO LAN access (the app that started it quit)." \
        "Fix: save (prefix C-s), then run: tmux kill-server, and reopen the terminal."
}

# --- macOS Command Overrides ---
alias python="python3"
alias open='open -a "QSpace Pro"'
alias ts="transmission-show"
alias rsync="/usr/local/bin/rsync-3.1.2"
alias fs="stat -f \"%z bytes\""
alias cleanup="find . -type f -name '*.DS_Store' -ls -delete"
alias pio="$HOME/.platformio/penv/bin/pio"   # PlatformIO isn't on PATH on its own

# --- macOS System Management ---
alias port="lsof -iTCP -sTCP:LISTEN -n -P"
alias afk="/System/Library/CoreServices/Menu\ Extras/User.menu/Contents/Resources/CGSession -suspend"
alias battery='system_profiler SPPowerDataType | grep -A3 -B7 "Condition"'
alias hidedkp="defaults write com.apple.finder CreateDesktop -bool false && killall Finder"
alias showdkp="defaults write com.apple.finder CreateDesktop -bool true && killall Finder"
alias show="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
alias hide="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"
alias flush="dscacheutil -flushcache && killall -HUP mDNSResponder"
alias lscleanup="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -kill -r -domain local -domain system -domain user && killall Finder"
alias emptytrash="sudo rm -rfv /Volumes/*/.Trashes; sudo rm -rfv ~/.Trash; sudo rm -rfv /private/var/log/asl/*.asl; sqlite3 ~/Library/Preferences/com.apple.LaunchServices.QuarantineEventsV* 'delete from LSQuarantineEvent'"
alias chromekill="ps ux | grep '[C]hrome Helper --type=renderer' | grep -v extension-process | tr -s ' ' | cut -d ' ' -f2 | xargs kill"
alias quitall="osascript -e \"tell application \"System Events\" to set quitapps to name of every application process whose visible is true and name is not \"Finder\" and name is not \"Sublime Text\" and name is not \"Alacritty\" and name is not \"Arc\"\" -e \"repeat with closeall in quitapps\" -e \"tell application closeall to quit\" -e \"end repeat\" 2>/dev/null; echo \"👌 Awesome, all set.\""
alias stfu="osascript -e 'set volume output muted true'"
alias pumpitup="osascript -e 'set volume output volume 100'"

# --- macOS Network ---
alias localip="ipconfig getifaddr en0"

# --- Homebrew ---
alias bi="brew install"
alias bu="brew uninstall"
alias bic="brew install --cask"
alias buc="brew uninstall --cask"
alias update="brew update; brew upgrade; brew cleanup; npm install npm -g; npm update -g"

# --- macOS-only zinit plugins ---
if (( ${+commands[zinit]} )); then
    zinit ice wait lucid
    zinit snippet OMZP::conda-env
fi

# --- Conda (lazy init; supports Apple Silicon and Intel Homebrew) ---
conda() {
    local _conda_root
    local _conda_setup

    unfunction conda

    _conda_root="$(macos_conda_root 2>/dev/null)"
    if [[ -n "${_conda_root}" ]]; then
        _conda_setup="$("${_conda_root}/bin/conda" shell.zsh hook 2>/dev/null)"
        if [[ $? -eq 0 && -n "${_conda_setup}" ]]; then
            eval "${_conda_setup}"
        elif [[ -f "${_conda_root}/etc/profile.d/conda.sh" ]]; then
            . "${_conda_root}/etc/profile.d/conda.sh"
        else
            export PATH="${_conda_root}/bin:${PATH}"
        fi
        unset _conda_setup
        unset _conda_root
        conda "$@"
        return
    fi

    unset _conda_setup
    unset _conda_root
    echo "conda not found" >&2
    return 127
}

macos_conda_root() {
    local _conda_root

    for _conda_root in \
        "/opt/homebrew/Caskroom/miniconda/base" \
        "/usr/local/Caskroom/miniconda/base"; do
        [[ -x "${_conda_root}/bin/conda" ]] && {
            printf '%s\n' "${_conda_root}"
            return 0
        }
    done

    return 1
}
