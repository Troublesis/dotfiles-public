# Windows: Sublime Text 4 config is shared with macOS via the same source files.
# The Library/ exclude above would hide them; un-ignore the Sublime User dir so
# run_onchange_41-sublime-sync.ps1.tmpl can sync them to %APPDATA%.
{{- if eq .chezmoi.os "windows" }}
!Library/Application Support/Sublime Text/
{{- end }}

# Docker — macOS only (OrbStack + remote NAS context)
{{- if ne .chezmoi.os "darwin" }}
.docker/
{{- end }}

# Windows-only bootstrap + PowerShell launchers
{{- if ne .chezmoi.os "windows" }}
.config/powershell/
.config/cmd/
run_once_40-windows-setup.ps1.tmpl
{{- end }}

# Bash run-scripts — Windows has no bash interpreter, so fork/exec fails with
# "%1 is not a valid Win32 application". The Linux/macOS/NAS scripts already
# carry OS guards, but their #!/bin/bash shebang renders OUTSIDE the guard,
# leaving a non-empty one-liner chezmoi still tries to run. Exclude every
# run_*.sh wholesale on Windows; the .ps1 bootstrap handles Windows setup.
{{- if eq .chezmoi.os "windows" }}
run_*.sh
{{- end }}

# Windows-only dotfiles (Git Bash rc files + %APPDATA% app configs).
# Never deploy these on macOS/Linux/NAS: they'd clobber the zsh-era ~/.bashrc
# and create a stray AppData/ tree.
{{- if ne .chezmoi.os "windows" }}
AppData/
.bashrc
.bash_profile
{{- end }}

# Windows reads Alacritty from %APPDATA%\alacritty (AppData/ target above);
# don't also drop a dead copy in ~/.config/alacritty.
{{- if eq .chezmoi.os "windows" }}
.config/alacritty/
{{- end }}
