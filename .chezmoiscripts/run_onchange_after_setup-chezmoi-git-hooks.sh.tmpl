{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# Configure the chezmoi source repo to use the in-repo .githooks/ directory.
#
# This runs during `chezmoi apply`. It only touches the chezmoi source repo
# itself (the dotfiles checkout) — never any other repo on the system.
#
# Re-runs whenever the hook contents change (the hashes below are baked into
# the rendered script by chezmoi templates).
#
# Hook fingerprints (force re-run on change):
#   pre-commit: {{ include ".githooks/pre-commit" | sha256sum }}
#   pre-push:   {{ include ".githooks/pre-push"   | sha256sum }}
#   gate:       {{ include "tools/check-public.sh" | sha256sum }}

set -euo pipefail

source_dir="{{ .chezmoi.sourceDir }}"

if [[ ! -d "$source_dir/.git" ]]; then
  echo "setup-chezmoi-git-hooks: $source_dir is not a git checkout — skipping." >&2
  exit 0
fi

if [[ ! -d "$source_dir/.githooks" ]]; then
  echo "setup-chezmoi-git-hooks: $source_dir/.githooks missing — skipping." >&2
  exit 0
fi

# Identity for the PUBLIC repo: only a GitHub noreply address may author commits
# (a real email would be published forever). Set once from chezmoi data; the gate
# (tools/check-public.sh --identity) fails commits/pushes if it is missing or wrong.
noreply="{{ .noreply_email | default "" }}"
if [[ -n "$noreply" ]]; then
  git -C "$source_dir" config --local user.email "$noreply"
fi

# Ensure hooks are executable (git won't run them otherwise).
chmod +x "$source_dir/.githooks/"* "$source_dir/tools/"*.sh 2>/dev/null || true

current=$(git -C "$source_dir" config --local --get core.hooksPath 2>/dev/null || true)
if [[ "$current" != ".githooks" ]]; then
  git -C "$source_dir" config --local core.hooksPath .githooks
  echo "setup-chezmoi-git-hooks: set core.hooksPath=.githooks in $source_dir"
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  printf '\033[1;33m%s\033[0m\n' \
    "setup-chezmoi-git-hooks: gitleaks not installed — pre-commit will use the built-in fallback." >&2
{{ if eq .chezmoi.os "darwin" -}}
  printf '\033[1;33m%s\033[0m\n' \
    "                         Install: brew install gitleaks" >&2
{{ else -}}
  printf '\033[1;33m%s\033[0m\n' \
    "                         Install: https://github.com/gitleaks/gitleaks/releases" >&2
{{ end -}}
fi
{{- end -}}
