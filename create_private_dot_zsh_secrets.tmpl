# ~/.zsh_secrets - created ONCE by chezmoi (create_ never overwrites an existing file).
# Source of truth: Bitwarden item "chezmoi/zsh-secrets" (one custom field per variable).
# Fallback: any variable listed below as "# export NAME=..." is simply filled in by hand (alias: es).
# Regenerate from the vault later: bw unlock, delete this file, run `chezmoi apply`.
{{- $item := includeTemplate "bw-item" "chezmoi/zsh-secrets" | fromJson }}
{{- $vals := dict }}
{{- range (dig "fields" (list) $item) }}{{ $_ := set $vals .name .value }}{{ end }}
{{- range $name := list "_LOCAL_AI_URL" "_LOCAL_AI_TOKEN" "_ZAI_URL" "_ZAI_TOKEN" "_DS_TOKEN" "MOSHI_HOOK_TOKEN" "GITHUB_PERSONAL_ACCESS_TOKEN" "OPENAI_API_KEY" "CF_API_TOKEN" "OCO_API_KEY" "OCO_API_URL" }}
{{- if hasKey $vals $name }}
export {{ $name }}={{ printf "'%s'" (replace "'" "'\\''" (index $vals $name)) }}
{{- else }}
# export {{ $name }}=
{{- end }}
{{- end }}
