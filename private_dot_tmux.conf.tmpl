# =============================================================================
# tmux.conf — managed by chezmoi
#   Source : ~/.local/share/chezmoi/private_dot_tmux.conf.tmpl
#   Deploy : ~/.tmux.conf
#   Pattern: shared config below, then chezmoi-inlined OS/host fragments,
#            then TPM init as the very last line.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Server / global behavior
# -----------------------------------------------------------------------------
set-environment -g TMUX_PLUGIN_MANAGER_PATH "$HOME/.tmux/plugins"
{{ if ne .chezmoi.os "windows" -}}
set-option -g detach-on-destroy off
{{- end }}
set-option -g focus-events on
set-option -sg escape-time 10
set-option -g repeat-time 0
{{ if ne .chezmoi.os "windows" -}}
set -s extended-keys on
{{- end }}
set -g history-limit 100000

# Forward useful env into new panes
set -ga update-environment TERM
set -ga update-environment TERM_PROGRAM
set -ga update-environment COLORTERM
set -ga update-environment MOSHI_CLIENT

# Allow OSC escape sequences (yazi image preview, OSC52 clipboard, etc.) to
# pass through tmux to the outer terminal.
set -g allow-passthrough on

# -----------------------------------------------------------------------------
# 2. Terminal & colors
# -----------------------------------------------------------------------------
# tmux-256color needs ncurses >= 6.1 terminfo; older hosts (CentOS/Oracle Linux 7:
# ncurses 5.9) lack it, and panes then fail with "unknown terminal type" (clear,
# less, vim…). Fall back to screen-256color there.
set -g default-terminal "screen-256color"
if-shell 'infocmp tmux-256color >/dev/null 2>&1' 'set -g default-terminal "tmux-256color"'
{{ if ne .chezmoi.os "windows" -}}
set-option -a terminal-features 'tmux-256color:RGB'
set-option -a terminal-features 'xterm-256color:RGB'
set-option -a terminal-features 'screen-256color:RGB'
set-option -a terminal-features 'xterm:RGB'
{{- end }}

# Tc fallback for older terminfo/nested-tmux scenarios
set-option -ga terminal-overrides ",xterm-256color:Tc"
set-option -ga terminal-overrides ",tmux-256color:Tc"
set-option -ga terminal-overrides ",screen-256color:Tc"
set-option -ga terminal-overrides ",xterm:Tc"

# -----------------------------------------------------------------------------
# 3. Clipboard — universal OSC52 + tmux-yank auto-detect
#
#   set-clipboard on   : tmux emits OSC52 escape sequences on every copy.
#                        The OUTER terminal (Ghostty / WezTerm / Kitty / iTerm2
#                        / Alacritty) catches them and writes to the physical
#                        machine's OS clipboard — works locally AND over SSH.
#   allow-passthrough  : required for OSC52 to traverse tmux nesting / SSH.
#
#   tmux-yank picks pbcopy (Darwin) / wl-copy (Wayland) / xsel / xclip (X11)
#   / clip.exe (WSL) automatically when there is a local display. Do NOT set
#   @override_copy_command — it would short-circuit the auto-detect path and
#   leave the selection trapped inside tmux's internal buffer.
# -----------------------------------------------------------------------------
set -s set-clipboard on

# -----------------------------------------------------------------------------
# 4. Indexing & window management
# -----------------------------------------------------------------------------
set-option -g base-index 1
set-option -g pane-base-index 1
set -g renumber-windows on
set-option -g automatic-rename on
{{ if ne .chezmoi.os "windows" -}}
set-option -g automatic-rename-format '#{b:pane_current_path}'
{{- end }}
set -g set-titles on
set -g set-titles-string "#I: #W"
setw -g aggressive-resize off
setw -g monitor-activity off
set -g synchronize-panes off

{{- /* Sections 5-7 (mouse/copy-mode, ALL key bindings, status bar) are shared with
     the work repo's rmux config: edit .chezmoitemplates/shared/tmux-common.conf. */}}
{{ template "shared/tmux-common.conf" (merge (dict "mux" (ternary "psmux" "tmux" (eq .chezmoi.os "windows"))) .) -}}

# Clear status regions for Moshi clients so swipe detection stays clean
if-shell '[ -n "$MOSHI_CLIENT" ]' {
  set -g status-left ''
  set -g status-right ''
}

# -----------------------------------------------------------------------------
# 8. TPM plugin declarations
# -----------------------------------------------------------------------------
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-cpu'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'T1erno/tmux-auto-renumber-session'
set -g @plugin 'nhdaly/tmux-better-mouse-mode'

# continuum: auto-start tmux on login + auto-save every 15 min + auto-restore
# the last saved environment when the tmux server starts (e.g. after reboot).
# Manual save/restore also available: prefix + Ctrl-s / prefix + Ctrl-r.
set -g @continuum-boot    'on'
set -g @continuum-restore 'on'

# resurrect: capture visible pane contents so restored sessions show prior output
set -g @resurrect-capture-pane-contents 'on'

# vim-tmux-navigator: keep Ctrl-l free for the shell (see section 6); navigate
# right with Ctrl-Right instead.
set -g @vim_navigator_mapping_right "C-Right"

# tmux-yank: do NOT auto-copy on mouse drag — only copy when user presses 'y'
set -g @yank_with_mouse 'off'

# better-mouse-mode
set -g @emulate-scroll-for-no-mouse-alternate-buffer 'off'
set -g @scroll-speed-num-lines-per-scroll 1

# -----------------------------------------------------------------------------
# 9. OS-specific overrides  (chezmoi inlined)
# -----------------------------------------------------------------------------
{{ if eq .chezmoi.os "darwin" -}}
{{ include "dot_tmux/os.conf_darwin" }}
{{- else if eq .chezmoi.os "linux" -}}
{{ include "dot_tmux/os.conf_linux" }}
{{- else if eq .chezmoi.os "windows" -}}
{{ include "dot_tmux/os.conf_windows" }}
{{- else -}}
{{ include "dot_tmux/os.conf_default" }}
{{- end }}

# -----------------------------------------------------------------------------
# 10. Host-specific overrides  (chezmoi inlined)
# -----------------------------------------------------------------------------
{{ if eq .hostclass "mac-studio" -}}
{{ include "dot_tmux/host.conf_mac-studio" }}
{{- else if eq .hostclass "macbook" -}}
{{ include "dot_tmux/host.conf_macbook" }}
{{- else if eq .hostclass "nas" -}}
{{ include "dot_tmux/host.conf_nas" }}
{{- else if eq .hostclass "code-server" -}}
{{ include "dot_tmux/host.conf_code-server" }}
{{- else -}}
{{ include "dot_tmux/host.conf_default" }}
{{- end }}

# -----------------------------------------------------------------------------
# 11. TPM init — MUST be the last line in this file
# -----------------------------------------------------------------------------
{{ if ne .chezmoi.os "windows" -}}
run '~/.tmux/plugins/tpm/tpm'
{{- else -}}
# TPM is bash-only; on Windows psmux uses ppm (PowerShell plugin manager).
# Install: git clone https://github.com/psmux/psmux-plugins "$HOME\.psmux\plugins\ppm"
# Then press Prefix + I inside psmux to install declared plugins.
{{- end }}
