[
	{"keys": ["alt+t"],"command":"terminus_open","args": {"cwd":"${file_path:${folder}}" } },
	{"keys": ["ctrl+shift+w"],"command":"terminus_close","context": [{"key":"terminus_view"}] },
	{ "keys": ["ctrl+`"], "command": "toggle_terminus_panel" },
	{ "keys": ["ctrl+super+g"], "command": "find_all_under" },
	{ "keys": ["super+f2"], "command": "find_all_under" },
	{ "keys": ["super+alt+l"], "command": "split_selection_into_lines" },
	{ "keys": ["super+b"], "command": "toggle_side_bar" },
	{ "keys": ["super+shift+b"], "command": "build" },
	{ "keys": ["alt+up"], "command": "swap_line_up" },
	{ "keys": ["alt+down"], "command": "swap_line_down" },
	{ "keys": ["ctrl+n"], "command": "toggle_side_bar" },
	{ "keys": ["ctrl+alt+t"], "command": "toggle_tabs" },
	{
   "keys": ["super+alt+f"], // Mac
   "command": "js_prettier",
       // Tab to cycle forward in autocomplete
        "keys": ["tab"],
        "command": "auto_complete",
        "context": [
            { "key": "auto_complete_visible", "operator": "equal", "operand": true }
        ]
    },
        // Tab to move down in auto-complete list (like Down arrow)
    {
        "keys": ["tab"],
        "command": "move",
        "args": {"by": "lines", "forward": true},
        "context": [
            {"key": "auto_complete_visible", "operator": "equal", "operand": true}
        ]
    },

    // Shift+Tab to move up in auto-complete list (like Up arrow)
    {
        "keys": ["shift+tab"],
        "command": "move",
        "args": {"by": "lines", "forward": false},
        "context": [
            {"key": "auto_complete_visible", "operator": "equal", "operand": true}
        ]
    },

    // Enter to commit the selected completion
    {
        "keys": ["enter"],
        "command": "commit_completion",
        "context": [
            {"key": "auto_complete_visible", "operator": "equal", "operand": true}
        ]
    },

    // Escape to hide auto-complete
    {
        "keys": ["escape"],
        "command": "hide_auto_complete",
        "context": [
            {"key": "auto_complete_visible", "operator": "equal", "operand": true}
        ]
    }
]
